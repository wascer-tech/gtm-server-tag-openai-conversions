setup: |-
  const JSON = require('JSON');
  const Object = require('Object');

  const baseEventData = () => {
    return {
      event_name: 'purchase',
      event_id: 'evt-1',
      page_location: 'https://shop.example.com/checkout',
      ip_override: '203.0.113.10',
      user_agent: 'Mozilla/5.0',
      user_id: 'user-1',
      currency: 'USD',
      value: 25.98,
      user_data: {
        email_address: ' Person@Example.com ',
        address: {
          city: ' Sao Paulo ',
          postal_code: '01311-000',
          country: 'br'
        }
      },
      items: [
        {item_id: 'sku-1', item_name: 'Shirt', quantity: 2, price: 12.99}
      ]
    };
  };

  const mockEvent = (incoming) => {
    mock('getAllEventData', () => incoming);
    mock('getEventData', (path) => {
      const parts = path.split('.');
      let value = incoming;
      for (let i = 0; i < parts.length; i++) {
        if (!value) return undefined;
        value = value[parts[i]];
      }
      return value;
    });
  };

  const mockData = (overrides) => {
    const settings = {
      pixelId: 'px-1',
      apiKey: 'key-1',
      eventNameSource: 'standard',
      eventNameStandard: 'page_viewed',
      actionSource: 'web',
      validateOnly: false,
      autoMapEventData: true,
      autoMapUserData: true,
      useStore: false,
      storeCollection: 'openai_ads',
      storeKeySource: 'obref',
      storeRead: true,
      storeWrite: true,
      setOpprefCookie: false,
      setObrefCookie: false,
      cookieDomain: 'auto',
      cookieSameSite: 'Lax',
      opprefExpiration: '30',
      obrefExpiration: '365',
      adStorageConsent: 'notRequired',
      debug: false,
      optimistic: false
    };

    const keys = Object.keys(overrides || {});
    for (let i = 0; i < keys.length; i++) {
      settings[keys[i]] = overrides[keys[i]];
    }

    return settings;
  };

  const resolvedRequest = (response) => {
    return {
      then: (onSuccess) => {
        onSuccess(response);
        return {catch: () => {}};
      }
    };
  };

  const rejectedRequest = (error) => {
    return {
      then: () => {
        return {catch: (onError) => { onError(error); }};
      }
    };
  };

  mock('getCookieValues', () => []);
  mock('getRequestHeader', () => undefined);
  mock('setCookie', () => {});


___NOTES___

Which hosts the tag can reach
The tag talks to two hosts and send_http lists both. The OpenAI endpoint is
fixed at https://bzr.openai.com/*. The Wascer Store lives inside the container
that serves the request, and its address arrives at runtime in the x-url-api
header, so the entry covers the whole https://*.soureicdn.com/* range instead of
one container. If your container answers on another domain, add that host to
send_http in the template editor. Turn the Wascer Store off if you want the tag
to reach OpenAI only.

The Wascer Store depends on a container flag
Store reads and writes only work when enable_database is on for the container.
When the flag is off, the Store answers with an error and the tag keeps going.
No Store failure, timeout or missing document ever blocks the OpenAI request.

Event ids must match the pixel
OpenAI deduplicates a browser event and a server event when both carry the same
identifier. The pixel sends it as event_id and this tag sends it as id. Feed
both from the same value.

The Event ID field in Configuration is the place to do it, and it wins over
everything else. Without it the tag reads an event_id or id row from the event
data table, then event_id on the incoming event, and only then generates one.
A generated id cannot be deduplicated, so the tag says so in the debug log.

The timestamp window is seven days
OpenAI accepts events stamped within the last seven days and up to ten minutes
in the future. This tag stamps the event when it fires, so batching an old
export through it will fail.

Amounts travel in the minor unit
2599 means 25.99 in a two decimal currency. The tag converts what it reads from
the incoming event, and the amount_major field in the event data table lets you
hand it a regular value such as 25.99.
