    assertThat(capturedOptions.headers['Authorization']).isEqualTo('Bearer key-1');
    assertThat(capturedBody.integration_source).isEqualTo('wascer');
    assertThat(capturedBody.events.length).isEqualTo(1);

    const event = capturedBody.events[0];
    assertThat(event.id).isEqualTo('evt-1');
    assertThat(event.type).isEqualTo('order_created');
    assertThat(event.action_source).isEqualTo('web');
    assertThat(event.source_url).isEqualTo('https://shop.example.com/checkout');
    assertThat(event.opt_out).isEqualTo(false);
    assertThat(event.timestamp_ms > 0).isEqualTo(true);
    assertThat(event.data.type).isEqualTo('contents');
    assertThat(event.data.currency).isEqualTo('USD');
    assertThat(event.data.amount).isEqualTo(2598);
    assertThat(event.data.contents[0].id).isEqualTo('sku-1');
    assertThat(event.data.contents[0].amount).isEqualTo(1299);
    assertThat(event.data.contents[0].content_type).isEqualTo('product');
    assertThat(event.user.email_sha256.length).isEqualTo(64);
